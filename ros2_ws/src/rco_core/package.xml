<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rco_core</name>
  <version>0.1.0</version>

  <description>
    Core robotics modelling, kinematics, collision, trajectory, and workcell
    evaluation engine for Robot Cell Optimizer.
  </description>

  <maintainer email="183149325+wnzid@users.noreply.github.com">
    Md Nahidul Islam
  </maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometric_shapes</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning</depend>
  <depend>shape_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>xacro</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ur_description</test_depend>
  <test_depend>ur_moveit_config</test_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
