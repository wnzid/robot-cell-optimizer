<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
             schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rco_bringup</name>
  <version>0.1.0</version>

  <description>
    Launch and system composition package for Robot Cell Optimizer.
  </description>

  <maintainer email="183149325+wnzid@users.noreply.github.com">
    Md Nahidul Islam
  </maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rco_interfaces</exec_depend>
  <exec_depend>rco_core</exec_depend>
  <exec_depend>rco_optimizer</exec_depend>
  <exec_depend>rco_description</exec_depend>
  <exec_depend>rco_simulation</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
